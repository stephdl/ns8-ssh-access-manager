#!/bin/bash

#
# Copyright (C) 2026 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Provision a remote server and register it in the sam database.
# Must be run inside the module environment: runagent -m samN
#
# Usage: provision-server --hostname <hostname> --ip <ip> [options]
#

set -e

usage() {
    cat <<EOF
Usage: $(basename "$0") --hostname HOSTNAME --ip IP [OPTIONS]

Provision a remote host for SSH auditing and register it in the database.
The SSH password is prompted for, unless --password is given.

Required:
  --hostname HOSTNAME        Server hostname (e.g. server-prod-01)
  --ip       IP              Server IP address (e.g. 192.168.1.10)

Options:
  --user     USER            SSH user to connect with (default: root)
  --port     PORT            SSH port (default: 22)
  --password PASSWORD        SSH password (prompted when omitted)
  --env      ENV             Environment: production, staging, lab (default: production)
  --os       OS              OS family: rhel, debian, ubuntu, alpine, other (default: other)
  -h, --help                 Show this help message

The remote host must have sudo installed: the audit-collector account runs
every sam-* helper through it.
EOF
}

HOSTNAME=""
IP=""
SSH_USER="root"
SSH_PORT="22"
SSH_PASSWORD=""
ENV="production"
OS="other"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --hostname)          HOSTNAME="$2";     shift 2 ;;
        --ip)                IP="$2";           shift 2 ;;
        --user)              SSH_USER="$2";     shift 2 ;;
        --port)              SSH_PORT="$2";     shift 2 ;;
        --password)          SSH_PASSWORD="$2"; shift 2 ;;
        --env)               ENV="$2";          shift 2 ;;
        --os)                OS="$2";           shift 2 ;;
        -h|--help)           usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
done

if [[ -z "$HOSTNAME" || -z "$IP" ]]; then
    echo "Error: --hostname and --ip are required." >&2
    usage
    exit 1
fi

if [[ -z "$SSH_PASSWORD" ]]; then
    read -r -s -p "SSH password for ${SSH_USER}@${IP}: " SSH_PASSWORD
    echo
fi

echo "[provision-server] Provisioning ${SSH_USER}@${IP} and registering '${HOSTNAME}' ..."

# servers add provisions over SSH, generates the per-server key pair, deploys
# the sam-* helpers and runs the first scan. The row is only created on
# success, so a failure here leaves no half-registered server behind.
podman exec -i sam-server \
    python3 /app/app/manage.py servers add \
    --hostname "${HOSTNAME}" \
    --ip "${IP}" \
    --port "${SSH_PORT}" \
    --ssh-user "${SSH_USER}" \
    --ssh-password "${SSH_PASSWORD}" \
    --env "${ENV}" \
    --os "${OS}"

echo "[provision-server] Done. Server '${HOSTNAME}' is provisioned and scanned."
